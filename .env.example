# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=

# Telegram — @BotFather
TELEGRAM_BOT_TOKEN=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# Click (my.click.uz > Merchant cabinet)
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=
CLICK_MERCHANT_USER_ID=

# Payme (business.payme.uz)
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=

# Public base URL used to build payment return links
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ROOT_DOMAIN=uzmini.com

# Required for /api/admin/* routes. Generate a long random value; server-side only.
PLATFORM_ADMIN_SECRET=

# AI model gateways — server-side only; never use NEXT_PUBLIC_ for these.
# These are credential slots only. The app does not yet call these providers.
# Do not rotate keys to evade provider quotas; use only keys/usage permitted by each provider.
UZMINI_MODEL_PROVIDER=
UZMINI_MODEL_ID=

# OpenRouter: models such as Qwen/DeepSeek are selected by model ID, not separate keys.
OPENROUTER_API_KEY_1=
OPENROUTER_API_KEY_2=
OPENROUTER_API_KEY_3=
OPENROUTER_API_KEY_4=
OPENROUTER_API_KEY_5=

# OrcaRouter
ORCAROUTER_API_KEY_1=
ORCAROUTER_API_KEY_2=
ORCAROUTER_API_KEY_3=
ORCAROUTER_API_KEY_4=
ORCAROUTER_API_KEY_5=

# Groq
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_API_KEY_5=

# Google AI Studio / Gemini
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
